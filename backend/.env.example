# Server Configuration (Port 5001 avoids macOS AirPlay collision on 5000)
PORT=5001
NODE_ENV=development

# Client Origin (CORS allowlist)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Phase 2)
# Local: mongodb://localhost:27017/fable
# Cloud: mongodb+srv://<username>:<password>@cluster.mongodb.net/fable?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/fable

# JWT Signing Secret (Phase 2)
# Generate a strong 32+ character random string
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Cross-Site Cookie Flag (Phase 9 production cross-domain only)
COOKIE_CROSS_SITE=false

# Future Phase Credentials (Do not populate until required phase)
# GROQ_API_KEY=
