# ==============================================================================
# Fable Backend — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize for your local or production environment.
# IMPORTANT: Never commit your actual .env file or credentials to version control.

# Server Configuration
# Port 5001 avoids macOS AirPlay collision on port 5000
PORT=5001
NODE_ENV=development

# Client Origin (CORS allowlist)
# Local development: http://localhost:5173
# Production: https://your-frontend-domain.com
CLIENT_URL=http://localhost:5173

# MongoDB Connection URI
# Local MongoDB: mongodb://127.0.0.1:27017/fable
# MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster.mongodb.net/fable?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/fable

# JWT Signing Secret (Minimum 16 characters, 32+ recommended)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# CSRF HMAC Secret (Optional, defaults to JWT_SECRET if omitted)
# Used for cryptographic HMAC-SHA256 double-submit CSRF token signatures
CSRF_SECRET=your_csrf_hmac_secret_key_here

# Groq Cloud API Key
# Required for AI-assisted agent configuration generation and runtime agent execution.
# Obtain a free developer key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_starts_with_gsk_here

# Cookie Architecture (SameSite configuration)
# Set to 'false' (default) when frontend and backend share the same parent domain (SameSite=Lax).
# Set to 'true' only when deploying across different domains (e.g. Vercel frontend calling Render backend)
# which sets SameSite=None and Secure=true.
COOKIE_CROSS_SITE=false
