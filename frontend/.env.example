# ==============================================================================
# Fable Frontend — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.production to customize frontend build variables.

# Backend API Origin
# In local development: defaults to http://localhost:5001 if omitted
# In production: set to your deployed backend origin (e.g. https://api.yourdomain.com)
VITE_API_URL=http://localhost:5001
